@dataclass
class Hasil:
    penyakit: Penyakit
    skor: float
    cakupan: float
    gejala_cocok: list


class MesinInferensi:
    def __init__(self, kb):
        self.kb = kb
        self.fakta = {}             # kode gejala -> CF pengguna (0..1)
        self.umur = None
        self.risiko_tinggi = False
        self.durasi_demam = 0

    # ---- fakta ----
    def set_fakta(self, kode, cf):
        self.fakta[kode] = cf

    def sudah_ditanya(self, kode):
        return kode in self.fakta

    def ada_gejala_positif(self):
        return any(v > 0 for v in self.fakta.values())

    # ---- perhitungan skor penyakit ----
    def _skor(self, p):
        cf, cocok, penalti, daftar = 0.0, 0.0, 1.0, []
        for g, w in p.aturan.items():
            u = self.fakta.get(g)
            if u is None:
                continue
            if u > 0:
                cf = cf + (w * u) * (1 - cf)       # kombinasi CF paralel (MYCIN)
                cocok += w * u
                daftar.append(g)
            elif w >= BOBOT_KHAS:
                penalti *= (1 - PENALTI_KHAS * w)  # gejala khas tidak ada -> turunkan
        cakupan = cocok / p.total_bobot
        skor = cf * (0.6 + 0.4 * cakupan) * penalti
        skor *= self._modifier(p)
        return min(skor, 0.99), cakupan, daftar

    def _modifier(self, p):
        """Penyesuaian kontekstual berdasarkan lama demam."""
        m = 1.0
        if self.durasi_demam >= 3:
            if p.kode in ("D07", "D08"):
                m *= 1.15
            elif p.kode in ("D01", "D03"):
                m *= 0.85
        return m

    def hitung(self):
        hasil = []
        for p in self.kb.penyakit.values():
            skor, cakupan, daftar = self._skor(p)
            if skor > 0:
                hasil.append(Hasil(p, skor, cakupan, daftar))
        hasil.sort(key=lambda h: h.skor, reverse=True)
        return hasil

    # ---- red flag & triase ----
    def red_flags_terpicu(self):
        out = []
        for rf in self.kb.red_flags:
            if all(self.fakta.get(g, 0) >= rf.min_cf for g in rf.gejala):
                out.append(rf)
        return out

    def triase(self, hasil):
        """1 = rawat mandiri, 2 = konsultasi dokter, 3 = segera ke IGD."""
        if self.red_flags_terpicu():
            return 3
        level = 1
        if hasil:
            top = hasil[0]
            level = {1: 1, 2: 2, 3: 2}[top.penyakit.keparahan]
            if top.penyakit.keparahan == 3 and top.skor >= 0.6:
                level = 3
            if top.penyakit.keparahan >= 2 and top.skor < 0.25:
                level = max(1, level - 1)
        if self.risiko_tinggi or (self.umur is not None and (self.umur <= 5 or self.umur >= 60)):
            if hasil:
                level = min(3, level + 1)
        if self.durasi_demam >= 3:
            level = max(level, 2)
        return level

    # ---- pemilihan pertanyaan adaptif ----
    def pertanyaan_berikutnya(self):
        hasil = self.hitung()
        kandidat = hasil[:5]
        belum = [g for g in self.kb.gejala if not self.sudah_ditanya(g)]
        if not belum:
            return None
        best, best_val = None, 0.0
        for g in belum:
            val = 0.0
            for h in kandidat:
                w = h.penyakit.aturan.get(g, 0)
                val += (h.skor + 0.1) * w
            if val > best_val:
                best, best_val = g, val
        return best

    def cukup_yakin(self, hasil):
        if not hasil:
            return False
        if hasil[0].skor < AMBANG_YAKIN:
            return False
        if len(hasil) == 1:
            return True
        return hasil[0].skor - hasil[1].skor >= AMBANG_SELISIH


