        print("\n!! TANDA BAHAYA TERDETEKSI !!")
        for r in rf:
            print(f"   - {r.pesan}")

    if not hasil:
        print("\nTidak ada penyakit di basis pengetahuan yang cocok dengan gejala Anda.")
        if not mesin.ada_gejala_positif():
            print("Anda tampaknya dalam kondisi sehat. Pertahankan pola hidup sehat!")
        else:
            print("Kombinasi gejala ini perlu evaluasi dokter.")
    else:
        print("\nKemungkinan penyakit (diurutkan):")
        for i, h in enumerate(hasil[:5], 1):
            bar = "#" * int(h.skor * 20)
