class IOInteraktif:
    def profil(self):
        umur = self._angka("Umur Anda (tahun): ", 0, 120)
        print("Apakah Anda sedang hamil atau punya penyakit penyerta")
        r = input("(diabetes, jantung, asma, ginjal, daya tahan tubuh lemah)? (y/n): ").strip().lower()
        return umur, r == "y"

    def skala(self, gejala):
        print(f"\nApakah Anda mengalami {gejala.pertanyaan}?")
        for k, (label, _) in SKALA.items():
            print(f"   [{k}] {label}")
        while True:
            s = input("   Pilihan (0-3): ").strip()
            if s in ("0", "1", "2", "3"):
                return int(s)
            print("   Input tidak valid, ketik angka 0 sampai 3.")

    def durasi(self):
        return self._angka("Sudah berapa hari Anda demam? ", 0, 60)

    @staticmethod
    def _angka(prompt, lo, hi):
        while True:
            s = input(prompt).strip()
            if s.isdigit() and lo <= int(s) <= hi:
                return int(s)
            print(f"   Masukkan angka {lo}-{hi}.")


class IODemo:
    def __init__(self, umur, risiko, jawaban, durasi=0):
        self.umur, self.risiko, self.jawaban, self._durasi = umur, risiko, jawaban, durasi

    def profil(self):
        return self.umur, self.risiko

    def skala(self, gejala):
        return self.jawaban.get(gejala.kode, 0)

    def durasi(self):
        return self._durasi


