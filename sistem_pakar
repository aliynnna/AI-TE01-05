            if i == 1:
                nama = [mesin.kb.gejala[g].nama for g in h.gejala_cocok]
                print(f"     Gejala cocok: {', '.join(nama)}")
        top = hasil[0].penyakit
        print(f"\nDugaan terkuat : {top.nama}")
        print(f"Penjelasan     : {top.deskripsi}")
        print(f"Saran          : {top.saran}")
        print(f"Segera ke dokter bila: {top.kapan_ke_dokter}")
        if len(hasil) > 1 and hasil[0].skor - hasil[1].skor < 0.10:
            print(f"\nCatatan: skor {hasil[1].penyakit.nama} sangat dekat; "
                  "keduanya perlu dipertimbangkan.")

    label = {1: "RENDAH - perawatan mandiri sambil dipantau",
             2: "SEDANG - sebaiknya konsultasi ke dokter dalam 1-2 hari",
             3: "TINGGI - segera ke IGD / fasilitas kesehatan terdekat"}[level]
    print(f"\nTingkat urgensi: {label}")
    print("-" * 64)
    print("Sistem ini hanya alat bantu edukasi, bukan pengganti diagnosis dokter.")
    print("=" * 64)


def simpan_riwayat(conn, mesin, hasil, level):
    ringkas = [{"penyakit": h.penyakit.nama, "skor": round(h.skor, 3)} for h in hasil[:5]]
    conn.execute(
        "INSERT INTO riwayat(waktu,umur,risiko_tinggi,durasi_demam,fakta,hasil,triase) VALUES (?,?,?,?,?,?,?)",
        (datetime.now().isoformat(timespec="seconds"), mesin.umur, int(mesin.risiko_tinggi),
         mesin.durasi_demam, json.dumps(mesin.fakta), json.dumps(ringkas, ensure_ascii=False), str(level)))
    conn.commit()


def konsultasi(conn, io, verbose=True):
    kb = BasisPengetahuan(conn)
    mesin = MesinInferensi(kb)

    if verbose:
        print("=" * 64)
        print("     SISTEM PAKAR DIAGNOSA AWAL KESEHATAN v2 (Certainty Factor)")
        print("=" * 64)
        print("Jawab pertanyaan dengan skala: 0=Tidak, 1=Ragu/ringan, 2=Ya, 3=Ya jelas/parah\n")

    mesin.umur, mesin.risiko_tinggi = io.profil()

    def tanya(kode):
        if mesin.sudah_ditanya(kode):
            return
        mesin.set_fakta(kode, SKALA[io.skala(kb.gejala[kode])][1])

    # Tahap 1: skrining keluhan umum
    for kode in kb.gejala_skrining():
        tanya(kode)

    if mesin.fakta.get("S01", 0) > 0:
        mesin.durasi_demam = io.durasi()

    # Tahap 2: pertanyaan adaptif
    if mesin.ada_gejala_positif():
        for _ in range(MAKS_PERTANYAAN_ADAPTIF):
            if mesin.cukup_yakin(mesin.hitung()):
                break
            nxt = mesin.pertanyaan_berikutnya()
            if nxt is None:
                break
            tanya(nxt)

        # Tahap 3: pertanyaan keselamatan (tanda bahaya)
        for kode in GEJALA_KESELAMATAN:
            tanya(kode)

    hasil = mesin.hitung()
    level = mesin.triase(hasil)
    if verbose:
        tampilkan_hasil(mesin, hasil, level)
    simpan_riwayat(conn, mesin, hasil, level)
    return mesin, hasil, level


def tampilkan_riwayat(conn):
    rows = conn.execute("SELECT id,waktu,umur,hasil,triase FROM riwayat ORDER BY id DESC LIMIT 20").fetchall()
    if not rows:
        print("Belum ada riwayat konsultasi.")
        return
    for id_, waktu, umur, hasil, triase in rows:
        h = json.loads(hasil)
        top = h[0]["penyakit"] if h else "-"
        print(f"#{id_:<3} {waktu}  umur={umur}  dugaan={top}  urgensi={triase}")


