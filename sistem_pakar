def init_db(path=DB_PATH):
    """Buat skema dan isi data awal bila database masih kosong."""
    conn = sqlite3.connect(path)
    conn.execute("PRAGMA foreign_keys = ON")
    cur = conn.cursor()
    cur.executescript("""
    CREATE TABLE IF NOT EXISTS gejala(
        kode TEXT PRIMARY KEY, nama TEXT NOT NULL,
        pertanyaan TEXT NOT NULL, skrining INTEGER NOT NULL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS penyakit(
        kode TEXT PRIMARY KEY, nama TEXT NOT NULL, deskripsi TEXT,
        keparahan INTEGER NOT NULL, saran TEXT, kapan_ke_dokter TEXT);
    CREATE TABLE IF NOT EXISTS aturan(
        penyakit TEXT NOT NULL REFERENCES penyakit(kode),
        gejala TEXT NOT NULL REFERENCES gejala(kode),
        bobot REAL NOT NULL CHECK(bobot > 0 AND bobot <= 1),
        PRIMARY KEY(penyakit, gejala));
    CREATE TABLE IF NOT EXISTS red_flag(
        kode TEXT PRIMARY KEY, pesan TEXT NOT NULL, min_cf REAL NOT NULL);
    CREATE TABLE IF NOT EXISTS red_flag_gejala(
        red_flag TEXT NOT NULL REFERENCES red_flag(kode),
        gejala TEXT NOT NULL REFERENCES gejala(kode),
        PRIMARY KEY(red_flag, gejala));
    CREATE TABLE IF NOT EXISTS riwayat(
        id INTEGER PRIMARY KEY AUTOINCREMENT, waktu TEXT NOT NULL,
        umur INTEGER, risiko_tinggi INTEGER, durasi_demam INTEGER,
        fakta TEXT NOT NULL, hasil TEXT NOT NULL, triase TEXT NOT NULL);
    """)
    if cur.execute("SELECT COUNT(*) FROM penyakit").fetchone()[0] == 0:
        cur.executemany("INSERT INTO gejala VALUES (?,?,?,?)", GEJALA)
        cur.executemany("INSERT INTO penyakit VALUES (?,?,?,?,?,?)", PENYAKIT)
        for p, daftar in ATURAN.items():
            cur.executemany("INSERT INTO aturan VALUES (?,?,?)",
                            [(p, g, w) for g, w in daftar.items()])
        for kode, pesan, gejala, min_cf in RED_FLAGS:
            cur.execute("INSERT INTO red_flag VALUES (?,?,?)", (kode, pesan, min_cf))
            cur.executemany("INSERT INTO red_flag_gejala VALUES (?,?)",
                            [(kode, g) for g in gejala])
    conn.commit()
    return conn


@dataclass
class Gejala:
    kode: str
    nama: str
    pertanyaan: str
    skrining: bool


@dataclass
class Penyakit:
    kode: str
    nama: str
    deskripsi: str
    keparahan: int
    saran: str
    kapan_ke_dokter: str
    aturan: dict = field(default_factory=dict)  # kode gejala -> bobot

    @property
    def total_bobot(self):
        return sum(self.aturan.values())


@dataclass
class RedFlag:
    kode: str
    pesan: str
    gejala: list
    min_cf: float


class BasisPengetahuan:
    """Memuat seluruh pengetahuan dari database ke memori."""

    def __init__(self, conn):
        self.gejala = {r[0]: Gejala(r[0], r[1], r[2], bool(r[3]))
                       for r in conn.execute("SELECT kode,nama,pertanyaan,skrining FROM gejala")}
        self.penyakit = {r[0]: Penyakit(*r) for r in conn.execute(
            "SELECT kode,nama,deskripsi,keparahan,saran,kapan_ke_dokter FROM penyakit")}
        for p, g, w in conn.execute("SELECT penyakit,gejala,bobot FROM aturan"):
            self.penyakit[p].aturan[g] = w
        rf = {r[0]: RedFlag(r[0], r[1], [], r[2])
              for r in conn.execute("SELECT kode,pesan,min_cf FROM red_flag")}
        for k, g in conn.execute("SELECT red_flag,gejala FROM red_flag_gejala"):
            rf[k].gejala.append(g)
        self.red_flags = list(rf.values())

    def gejala_skrining(self):
        return [g.kode for g in self.gejala.values() if g.skrining]


